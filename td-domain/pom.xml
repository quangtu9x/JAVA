<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.td</groupId>
        <artifactId>td-webapi-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>td-domain</artifactId>
    <packaging>jar</packaging>

    <name>TD WebAPI - Domain Layer</name>
    <description>Domain entities, value objects, domain events and business rules</description>

    <dependencies>
        <!-- Validation API -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- JPA API (for annotations only, no implementation) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!--
            Bugfix 26/08/2026 (lan 2): KHONG dua spring-data-commons/spring-data-jpa/spring-aspects
            vao domain nua. Lan dau da thu wire auditing chuan (@CreatedBy/@LastModifiedBy +
            AuditingEntityListener) nhung vo hieu trong runtime nay: listener do bi weave AspectJ va
            can duoc tiem AuditingHandler qua SpringBeanContainer cua Hibernate, trong khi ca 3
            persistence unit deu dung tay trong MultiPersistenceUnitJpaConfig (khong di duong
            auto-configure cua Boot) -> Hibernate new listener bang reflection thuong -> callback
            thanh no-op IM LANG, created_by/last_modified_by van NULL. Thay bang listener JPA thuan
            AuditableEntityListener + AuditCurrentUserHolder (cung package contracts); nguoi dung
            hien tai do AuditingConfig dang ky luc startup. Domain giu nguyen chi phu thuoc
            jakarta.persistence.
        -->

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>