# TD WebAPI - Environment Variables Template
# Copy this file to .env and update the values as needed

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=jdbc:postgresql://10.10.10.116:15432/tdwebapi
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin123

# ============================================
# MONGODB CONFIGURATION (Logging)
# ============================================
MONGODB_HOST=10.10.10.119
MONGODB_PORT=27017
MONGODB_DATABASE=tdwebapi_logs
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_DB=admin

# ============================================
# ERROR TRACKING CONFIGURATION (DB rieng, tach khoi DB nghiep vu)
# ============================================
# Dung chung Postgres server voi DATABASE_URL nhung KHAC database (tderrorlog).
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_RETENTION_DAYS=30
ERROR_TRACKING_CLEANUP_CRON=0 0 3 * * *
ERROR_TRACKING_DB_URL=jdbc:postgresql://10.10.10.116:15432/tderrorlog
ERROR_TRACKING_DB_USERNAME=admin
ERROR_TRACKING_DB_PASSWORD=admin123

# ============================================
# SO DANG KY TEP DINH KEM DUNG CHUNG (DB rieng, KHONG phai control-plane)
# ============================================
# Van ban den noi tinh/truc quoc gia + "Chuyen xu ly" dung chung 1 object MinIO cho moi don vi nhan; object chi
# bi xoa khi het don vi tham chieu. Tao database truoc (CREATE DATABASE tdfileregistry) - td-web tu migrate.
# td-woker PHAI tro CUNG database nay (td-woker/.env).
FILE_REGISTRY_ENABLED=true
FILE_REGISTRY_DB_URL=jdbc:postgresql://10.10.10.116:15432/tdfileregistry
FILE_REGISTRY_DB_USERNAME=admin
FILE_REGISTRY_DB_PASSWORD=admin123

# ============================================
# MULTI-TENANT / CONTROL-PLANE DATABASE (BL-117)
# ============================================
# Database Postgres RIENG (KHONG phai DATABASE_URL o tren), chi chua bang "tenants" (registry) +
# "categories" (danh muc dung chung moi tenant) - PHAI duoc DBA tu tao san (database rong) truoc khi
# chay app, app chi tu tao BANG ben trong, khong tu tao database. Xem
# docs/architecture/06-database-per-tenant-multi-tenant.md.
CONTROL_PLANE_DATABASE_URL=jdbc:postgresql://10.10.10.116:15432/tdwebapi_controlplane
CONTROL_PLANE_DATABASE_USERNAME=admin
CONTROL_PLANE_DATABASE_PASSWORD=admin123
# Ma hoa 2 chieu mat khau Postgres cua tung tenant luu trong bang "tenants" - BAT BUOC, mat gia tri
# nay sau khi da co tenant that = mat kha nang giai ma lai moi mat khau da luu. salt PHAI la chuoi
# HEX hop le (chi 0-9a-f).
TENANT_CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-real-secret
TENANT_CREDENTIAL_ENCRYPTION_SALT=deadbeefdeadbeef

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_SERVER_URL=http://10.10.10.116:9014
KEYCLOAK_REALM=td-webapi-realm
KEYCLOAK_CLIENT_ID=td-webapi-client
KEYCLOAK_CLIENT_SECRET=td-webapi-secret-2024

# Ma bao mat rieng cho chuc nang ADMIN "Chuyen tai khoan". Hay doi o production.
SWITCH_USER_SECURITY_CODE=123@!@#Aa

# ============================================
# MINIO CONFIGURATION (File Storage)
# ============================================
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=td-webapi-files

# ============================================
# ONLYOFFICE DOCUMENT SERVER (chuan bi truoc - CHUA co code Java nao doc cac bien nay)
# ============================================
# Xem JAVA/docs/ONLYOFFICE_FE_INTEGRATION.md. Doi ONLYOFFICE_JWT_SECRET khop dung gia tri
# cau hinh tren chinh Document Server that cua ban - KHONG dung lai gia tri vi du duoi day.
ONLYOFFICE_DOCSERVER_URL=http://localhost:8081
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=change-this-secret
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=true
# Secret RIENG cua Backend (KHONG trung ONLYOFFICE_JWT_SECRET o tren) - doi gia tri that khi trien khai.
ONLYOFFICE_INTERNAL_TOKEN_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
# BAT BUOC: dia chi Document Server goi nguoc toi Backend nay qua mang (KHONG dung localhost).
ONLYOFFICE_CALLBACK_BASE_URL=http://localhost:8111

# ============================================
# RABBITMQ / KAFKA (04/09/2026) - CUNG broker voi td-worker (JAVA/td-woker/.env.example)
# ============================================
# PHAI dat CUNG gia tri RABBITMQ_*/KAFKA_BOOTSTRAP_SERVERS o ca td-web va td-woker de 2 app doc lap
# cung tro toi 1 broker (xem docs/architecture/11-rabbitmq-vbdi-worker-phan-hoi-trang-thai.md
# addendum 04/09/2026).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# rabbit | kafka - doi broker KHONG can sua code, chi doi bien nay (xem MessagingProperties).
APP_MESSAGING_BROKER=rabbit

# ============================================
# REDIS - doc o td-web application.yml spring.data.redis (cache danh muc, cay co cau to chuc...)
# ============================================
# Thieu thi mac dinh localhost:6379. Redis dung chung voi he khac -> dat REDIS_DATABASE rieng cho Java.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2
REDIS_TIMEOUT=3s

# ============================================
# ELASTICSEARCH - dong bo do td-woker (xem docs/architecture/13-dong-bo-elasticsearch.md)
# ============================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Tim kiem nang cao doc index tim kiem (tu chay SQL khi tat/chua san sang/loi). Prefix PHAI trung td-woker.
SEARCH_ES_ENABLED=false
SEARCH_ES_INDEX_PREFIX=hscv
SEARCH_ES_MODULES=vbden,vbdi,duthao,hosocv,phieutrinhtd
# Tu khoa tim ca trong noi dung tep dinh kem (td-woker trich bang Tika/OCR - docs/architecture/14).
SEARCH_ES_INCLUDE_FILE_CONTENT=true

# ============================================
# TRUC LIEN THONG VAN BAN QUOC GIA - qua TD Gateway (project tdgateway)
# ============================================
# true: gui VB di toi noi nhan NGOAI TINH phat task guinhanquocgia.send cho TD Gateway (cung broker).
# false (mac dinh): ghi "Gui loi - chua bat ket noi Truc" vao Nhat ky gui nhan.
VBDI_NATIONAL_EXCHANGE_ENABLED=false
# Man /tonghop/trucquocgia (giam sat goi gui/nhan qua Truc): doc DB RIENG cua TD Gateway (GATEWAY_DB_URL ben
# tdgateway). Chi DOC. false: man bao "chua cau hinh".
# Bo trong USERNAME/PASSWORD (de comment) -> dung lai DATABASE_USERNAME/PASSWORD; production nen cap tai khoan
# rieng chi SELECT. Luu y: dong "NATIONAL_EXCHANGE_DB_USERNAME=" rong KHONG fallback (gia tri rong van la gia tri).
NATIONAL_EXCHANGE_ADMIN_ENABLED=false
NATIONAL_EXCHANGE_DB_URL=jdbc:postgresql://localhost:5432/tdgateway
# NATIONAL_EXCHANGE_DB_USERNAME=
# NATIONAL_EXCHANGE_DB_PASSWORD=
# Tenant cap tinh cho MOI man /tonghop (Tim kiem, Giam sat VB di, Truc quoc gia): xem toan tinh; tenant khac
# chi thay du lieu cua minh. Tai khoan tong (admin / PLATFORM_ADMIN) luon xem toan tinh.
PROVINCE_ADMIN_TENANT_IDS=H05
# Thao tac quan tri goi Truc (gui lai/nhan lai/phat lai/xu ly lai) - can GATEWAY_ADMIN_EXECUTOR_ENABLED=true ben gateway.
NATIONAL_EXCHANGE_OPERATIONS_ENABLED=false
# NATIONAL_EXCHANGE_COMMAND_DB_USERNAME=
# NATIONAL_EXCHANGE_COMMAND_DB_PASSWORD=
# Tai goi eDXML qua gateway (GATEWAY_ADMIN_HTTP_ENABLED=true); token trung GATEWAY_ADMIN_HTTP_TOKEN.
NATIONAL_EXCHANGE_GATEWAY_URL=
NATIONAL_EXCHANGE_GATEWAY_TOKEN=
# Ten co quan Truc tra Redis truoc (gateway day len HASH <prefix>:names) - prefix PHAI khop GATEWAY_ADMIN_AGENCY_REDIS_KEY_PREFIX
NATIONAL_EXCHANGE_AGENCY_REDIS_ENABLED=true
NATIONAL_EXCHANGE_AGENCY_REDIS_KEY_PREFIX=tdgateway:national-agency

# ============================================
# SPRING CONFIGURATION
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8111

# ============================================
# PRODUCTION OVERRIDES (Optional)
# ============================================
# For production, override these values:
# KEYCLOAK_SERVER_URL=https://keycloak.yourdomain.com
# DATABASE_URL=jdbc:postgresql://prod-db:5432/tdwebapi
# MONGODB_HOST=prod-mongo
# KEYCLOAK_CLIENT_SECRET=your-secure-production-secret

# ============================================
# ADDITIONAL CONFIGURATION (Optional)
# ============================================
# JVM Options
JAVA_OPTS=-Xmx1g -Xms512m

# Logging Level
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_TD=DEBUG

# Cache Configuration
CACHE_TYPE=simple
CACHE_TTL=3600

# ============================================
# TDTOKEN (dang nhap tich hop FE)
# ============================================
# Bat buoc de /qlvb/authen phat hanh Tdtoken - neu thieu, request se loi "Sai token".
# Xem JAVA/docs/LOGIN_FE_TICH_HOP_AUTH.md muc 6.2.
TDTOKEN_JWT_SECRET=

# ============================================
# KY SO SIMPKI (TDSimPki)
# ============================================
# SIMPKI_BASE_URL PHAI co subpath /td-esign (WORKER_API_BASE_PATH phia TDSimPki), thieu se HTTP 404.
SIMPKI_ENABLED=false
SIMPKI_BASE_URL=https://qlvbv6.tandan.com.vn/td-esign
SIMPKI_API_KEY=
SIMPKI_TENANT_ID=default
