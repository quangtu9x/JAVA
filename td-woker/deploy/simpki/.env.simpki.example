# =====================================================================
# Môi trường TEST/triển khai CHỈ chạy module simpki.sign (docs/18-trien-khai-test-simpki.md).
# Copy file này thành ".env" NGAY CẠNH td-worker.jar trên máy chủ test (cùng thư mục chạy
# run-simpki.sh/run-simpki.ps1) rồi điền giá trị THẬT. KHÔNG commit file ".env" thật vào git.
#
# ⚠️ BẮT BUỘC chạy bằng run-simpki.sh/run-simpki.ps1 — KHÔNG tự ý gọi "java -jar td-worker.jar"
# trực tiếp. Lý do (đã tự phát hiện bằng thực nghiệm, xem docs/18 mục "Bug đã sửa"): cơ chế Spring
# Boot đọc ".env" (spring.config.import) KHÔNG tự map đúng các biến WORKER_TASKS_SIMPKI_*/
# WORKER_TASKS_GUINHANQUOCGIA_*/WORKER_DEBUG_ENDPOINT_* (module tự đăng ký @ConfigurationProperties,
# không có placeholder trong application.yml) — phải là biến môi trường HỆ ĐIỀU HÀNH THẬT thì mới
# đúng. run-simpki.sh/.ps1 đã tự động làm việc này (đọc .env rồi set làm biến môi trường thật trước
# khi chạy java) — nếu tự chạy "java -jar" thẳng, WORKER_TASKS_SIMPKI_ENABLED=true sẽ ÂM THẦM KHÔNG
# có tác dụng (Worker vẫn chạy nhưng dùng NoopSimPkiGatewayClient, luôn trả NOT_CONFIGURED).
# =====================================================================

# ---- Bắt buộc: kích hoạt profile "simpki" (application-simpki.yml) ----
SPRING_PROFILES_ACTIVE=simpki

# ---- Management/actuator port ----
WORKER_MANAGEMENT_PORT=8090

# ---- Database RIÊNG của Worker (checkpoint store) — DBA tạo TRƯỚC bằng create-database.sql ----
# Worker TỰ migrate bảng (Flyway) lúc khởi động đầu tiên — KHÔNG cần chạy tay file SQL migration nào.
#
# LỰA CHỌN A (mặc định, khuyến nghị cho môi trường thật) — Postgres:
WORKER_DB_URL=jdbc:postgresql://<db-host>:5432/tdworker
WORKER_DB_USERNAME=tdworker
WORKER_DB_PASSWORD=<mật khẩu thật đã đặt ở create-database.sql>
WORKER_DB_SCHEMA_MANAGEMENT=flyway
# WORKER_DB_DRIVER_CLASS_NAME=org.postgresql.Driver   # (mặc định, không cần khai báo)
#
# LỰA CHỌN B — máy chủ test CHƯA có Postgres/Docker: dùng H2 file cục bộ, KHÔNG cần cài đặt gì thêm
# (H2 đã bundle sẵn trong td-worker.jar). Comment 4 dòng Lựa chọn A ở trên, bỏ comment 4 dòng dưới:
# WORKER_DB_URL=jdbc:h2:file:./data/tdworker;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
# WORKER_DB_USERNAME=sa
# WORKER_DB_PASSWORD=
# WORKER_DB_SCHEMA_MANAGEMENT=script
# WORKER_DB_DRIVER_CLASS_NAME=org.h2.Driver
# Lưu ý H2 (xem docs/18-trien-khai-test-simpki.md mục "Chưa có Postgres/Docker — H2 file cục bộ"):
#   - CHỈ dùng cho test 1 instance — KHÔNG chạy nhiều Worker instance cùng trỏ 1 file H2.
#   - File .mv.db (thư mục "data/", tự tạo) — muốn "reset" sạch thì dừng Worker rồi xoá thư mục này.
#   - Khi có Postgres thật: đổi lại 4 dòng WORKER_DB_* về Lựa chọn A là xong, KHÔNG cần đổi code.

# ---- Control-plane (registry tenant của td-web) — simpki.sign KHÔNG cần dữ liệu tenant, tắt hẳn
# để môi trường test không cần dựng thêm database control-plane/tenant nào. ----
CONTROL_PLANE_ENABLED=false

# ---- RabbitMQ — cần bật để nhận task simpki.sign + publish phản hồi simpki.sign_reply. CHƯA có
# RabbitMQ? Có thể BỎ QUA khối này (đặt WORKER_RABBIT_ENABLED=false) và dùng
# WORKER_DEBUG_ENDPOINT_ENABLED=true + deploy/simpki/publish-test-http.sh/.ps1 để test độc lập qua
# HTTP thay vì broker — xem docs/18-trien-khai-test-simpki.md mục "Test độc lập không cần RabbitMQ". ----
RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
WORKER_RABBIT_ENABLED=true
WORKER_RABBIT_EXCHANGE=worker.exchange
# Tên biến RIÊNG cho hàng đợi simpki (profile "simpki" ghi đè toàn bộ worker.rabbit.queues) — KHÔNG
# trùng WORKER_RABBIT_QUEUE/WORKER_RABBIT_CONCURRENCY... của hàng đợi generic (nếu máy này CÒN chạy
# hàng đợi generic khác — xem docs/18-checklist mục cấu hình).
WORKER_SIMPKI_QUEUE_NAME=worker.simpki
WORKER_SIMPKI_QUEUE_CONCURRENCY=2
WORKER_SIMPKI_QUEUE_MAX_CONCURRENCY=4
WORKER_SIMPKI_QUEUE_PREFETCH=2

# ---- Timeout/lease — PHẢI dài hơn worker.tasks.simpki.timeout-seconds (mặc định 300s, chờ người
# dùng xác nhận trên điện thoại) — xem docs/18-trien-khai-test-simpki.md mục cấu hình timeout.
# Giá trị mặc định của profile "simpki" (330s/360) đã đủ dùng — chỉ cần đổi nếu tăng timeout-seconds. ----
# WORKER_UNIT_TIMEOUT=330s
# WORKER_CLAIM_LEASE_SECONDS=360

# ---- Instance id — nếu chạy nhiều instance simpki (không bắt buộc cho test 1 máy) ----
WORKER_INSTANCE_ID=simpki-test-1

# ---- Ký số SIM-PKI (MSSP/ETSI TS 102 204) — xem docs/17-checklist-tich-hop-kyso-simpki.md ----
WORKER_TASKS_SIMPKI_ENABLED=true
WORKER_TASKS_SIMPKI_SIGNATUREURL=https://mpki1.ca.gov.vn:18083/soap/services/MSS_SignaturePort
WORKER_TASKS_SIMPKI_MSSPID=http://hmssp.mobile-id.vn
WORKER_TASKS_SIMPKI_SIGNATUREPROFILE=http://mobile-id.vn/digitalSignature
WORKER_TASKS_SIMPKI_MSSFORMAT=http://uri.etsi.org/TS102204/v1.1.2#PKCS1
# AP_ID/AP_PASSWORD thật do Cục CTS-BMTT cấp (KHÔNG dùng giá trị mẫu này) — xem
# docs/TDSimSign/sdk-mobilepki/java/thanhhoa.txt.
WORKER_TASKS_SIMPKI_APID=
WORKER_TASKS_SIMPKI_APPASSWORD=
WORKER_TASKS_SIMPKI_TIMEOUTSECONDS=300
# Đường dẫn TƯƠNG ĐỐI tính từ thư mục chạy java -jar (cùng thư mục .env này) — copy 2 file keystore
# vào certs/simpki/ ngay cạnh td-worker.jar trước khi chạy, xem docs/18 mục chuẩn bị chứng thư.
WORKER_TASKS_SIMPKI_TRUSTSTOREPATH=certs/simpki/truststore-bcy.jks
WORKER_TASKS_SIMPKI_TRUSTSTOREPASSWORD=changeit
WORKER_TASKS_SIMPKI_KEYSTOREPATH=certs/simpki/<ten-file-keystore-that>.p12
WORKER_TASKS_SIMPKI_KEYSTOREPASSWORD=
WORKER_TASKS_SIMPKI_KEYSTORETYPE=PKCS12
WORKER_TASKS_SIMPKI_REPLYTASKTYPE=simpki.sign_reply

# ---- Debug/test — trigger 1 task TRỰC TIẾP qua HTTP, KHÔNG cần RabbitMQ (deploy/simpki/
# publish-test-http.sh/.ps1) — xem docs/18-trien-khai-test-simpki.md mục "Test độc lập không cần
# RabbitMQ". CHỈ bật dev/test — KHÔNG bật ở production/expose port này ra Internet (endpoint không
# có xác thực riêng). Để mặc định false nếu ĐÃ có RabbitMQ test qua publish-test-signal.sh/.ps1. ----
WORKER_DEBUG_ENDPOINT_ENABLED=false

# ---- Logging ----
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_TD_WORKER=DEBUG
LOG_FILE=logs/td-worker.log

# ---- QUAN TRỌNG — yêu cầu hạ tầng KHÔNG cấu hình được bằng biến môi trường (xem
# certs/simpki/README.md + docs/17-checklist mục A3): máy chủ chạy Worker này PHẢI NAT ra Internet
# bằng 1 trong các IP Public đã đăng ký với Cục CTS-BMTT cho AP_ID ở trên — nếu không, MỌI lần ký sẽ
# nhận lỗi giao thức UNAUTHORIZED_ACCESS (đã thực nghiệm xác nhận), dù cấu hình phần mềm đúng 100%.
