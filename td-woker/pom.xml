<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <!--
      WORKER đứng ĐỘC LẬP hoàn toàn (không phải module Maven của td-webapi-parent) -
      kế thừa QUYẾT ĐỊNH KIẾN TRÚC của project Spring Boot tham khảo (Java 17, Spring Boot
      3.2.0, PostgreSQL/Hikari, Jackson, Micrometer) nhưng sở hữu source/config/module riêng,
      KHÔNG tạo dependency nào khiến Worker phải chạy cùng td-web.
    -->
    <groupId>com.td.worker</groupId>
    <artifactId>td-worker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>TD Worker Platform</name>
    <description>Generic distributed Worker Platform - multi-tenant, multi-unit, competing consumers,
        checkpoint/idempotency, RabbitMQ + Kafka, PostgreSQL/MinIO/HTTP connection pools.</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <postgresql.version>42.7.0</postgresql.version>
        <flyway.version>9.22.3</flyway.version>
        <minio.version>8.5.7</minio.version>
        <!-- 17/10/2026: trích nội dung tệp (docs/architecture/14-trich-noi-dung-tep.md). OCR cần cài Tesseract ngoài. -->
        <tika.version>2.9.2</tika.version>
        <!-- minio 8.5.7 kéo commons-compress 1.24.0 (thắng theo độ sâu) — Tika 2.9.2 cần 1.26.x, thiếu thì NoSuchMethodError khi trích docx/pdf. -->
        <commons-compress.version>1.26.1</commons-compress.version>
        <httpclient5.version>5.3</httpclient5.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>

<dependencies>
        <!-- Web + Actuator: worker KHÔNG có controller nghiệp vụ, chỉ dùng để phục vụ
             /actuator/health + /actuator/prometheus trên cổng riêng (docs/architecture/11 §13.6). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JDBC/HikariCP cho checkpoint store + registry control-plane + tenant pools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- Message brokers: RabbitMQ (AMQP) + Kafka -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- spring-security-crypto: Encryptors.text(key, salt) để giải mã mật khẩu tenant
             (CÙNG thuật toán/key/salt với td-web, bắt buộc - docs/architecture/11 §13.3).
             Chỉ dùng thư viện crypto, KHÔNG bật Security filter chain. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Migration schema cho database RIÊNG của Worker (không đụng migration td-web) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- MinIO (envelope chỉ chứa objectKey/sha256 - "message nhẹ", docs/architecture/08 §3.2) -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
        </dependency>
        <!-- Trích chữ PDF/Word/Excel/PowerPoint/ODF/RTF/HTML + OCR (Tesseract) — FileContentExtractor -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- HTTP client pool (Apache HttpClient 5) cho handler gọi API ngoài -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${httpclient5.version}</version>
        </dependency>

        <!-- Lombok (đúng convention project tham khảo) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Structured logging (JSON cho file log production) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 (PostgreSQL mode) — dùng cho unit test checkpoint store/flow runner VÀ
             làm TUỲ CHỌN checkpoint store khi máy chủ test CHƯA có Postgres/Docker sẵn — CỐ Ý bỏ
             scope "test" (mặc định compile) để có mặt trong jar production, KHÔNG bắt buộc dùng: mặc
             định mọi hướng dẫn/docker-compose.yml của Worker vẫn dùng Postgres, H2 chỉ được kích hoạt
             khi tự tay đổi WORKER_DB_URL sang "jdbc:h2:file:...". WorkerSchemaMigrator đã tự chọn
             đúng script (worker-schema-h2.sql/worker-schema-postgres.sql) theo URL khi
             worker.db.schema-management=script — không cần đổi code nào khác. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <!-- PostgreSQL thật (Testcontainers) - H2 KHÔNG parse được "INSERT ... ON CONFLICT" (đã xác
             nhận: lỗi cú pháp trên mọi MODE, không phải vấn đề tương thích) nên các test cần SQL
             Postgres thật (dedup vbdi.delivery, JSONB documents.dynamic_fields) không thể dùng H2.
             Cùng pattern đã dùng ở td-web (DynamicFieldsJsonbIntegrationTest/
             TenantSchemaIsolationIntegrationTest) - version do spring-boot-starter-parent quản lý. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>td-worker</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
