# =====================================================================
# TD WORKER - Environment Variables Template
# Copy this file to .env and update the values. KHÔNG commit credential thật.
# Mọi secret của Worker đều nạp qua biến môi trường (docs/promt.txt Externalized config).
# =====================================================================

# ---- Management/actuator port (RIÊNG khỏi td-web, docs/architecture/11 §13.6) ----
WORKER_MANAGEMENT_PORT=8090
SPRING_PROFILES_ACTIVE=dev

# ---- Database RIÊNG của Worker (checkpoint store) - DO DBA tạo TRƯỚC ----
WORKER_DB_URL=jdbc:postgresql://localhost:5432/tdworker
WORKER_DB_USERNAME=postgres
WORKER_DB_PASSWORD=postgres
# flyway | script (script dùng cho test/H2)
WORKER_DB_SCHEMA_MANAGEMENT=flyway
# batch (mặc định) hoặc single. Batch chạy ngay theo từng message, không chờ đủ batch size.
WORKER_DB_UNIT_INSERT_MODE=batch
WORKER_DB_UNIT_INSERT_BATCH_SIZE=100
WORKER_DB_VALIDATION_TIMEOUT_MS=5000
WORKER_DEPENDENCY_RETRY_INTERVAL=5m
WORKER_TENANT_DB_VALIDATION_TIMEOUT_MS=5000

# ---- Control-plane (registry tenant của td-web) - CHỈ ĐỌC, CÙNG key/salt với td-web ----
CONTROL_PLANE_ENABLED=true
CONTROL_PLANE_DATABASE_URL=jdbc:postgresql://localhost:5432/tdwebapi_controlplane
CONTROL_PLANE_DATABASE_USERNAME=postgres
CONTROL_PLANE_DATABASE_PASSWORD=postgres
# BẮT BUỘC CÙNG GIÁ TRỊ với td-web (docs/architecture/11 §13.3) - khác = không giải mã được tenant.
TENANT_CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-real-secret
TENANT_CREDENTIAL_ENCRYPTION_SALT=deadbeefdeadbeef

# ---- RabbitMQ (bật bằng WORKER_RABBIT_ENABLED=true) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
WORKER_RABBIT_ENABLED=false
WORKER_RABBIT_QUEUE=worker.tasks
WORKER_RABBIT_EXCHANGE=worker.exchange
# Message lỗi hạ tầng đợi tại retry queue trong thời gian này rồi quay lại main queue.
WORKER_RABBIT_RETRY_DELAY_MS=5000
WORKER_RABBIT_MAX_REDELIVERIES=8
WORKER_RABBIT_CONCURRENCY=4
WORKER_RABBIT_MAX_CONCURRENCY=8
# 1-10; không để giá trị lớn khiến broker dồn message vào RAM.
WORKER_RABBIT_PREFETCH=5
# 0 = không giới hạn; ví dụ 20 = tối đa 20 message/s mỗi queue.
WORKER_RABBIT_RATE_LIMIT_PER_SECOND=0

# ---- Kafka (bật bằng WORKER_KAFKA_ENABLED=true) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WORKER_KAFKA_ENABLED=false
WORKER_KAFKA_TOPIC=worker.tasks

# ---- MinIO (tuỳ chọn) ----
MINIO_ENABLED=false
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=td-webapi-files

# So dang ky tep dinh kem dung chung - CUNG database voi FILE_REGISTRY_DB_* cua td-web (td-web migrate schema).
# Job don dep chay luc 02:30, chi xoa object het don vi tham chieu qua FILE_REGISTRY_GRACE_PERIOD (can MINIO_ENABLED=true).
FILE_REGISTRY_ENABLED=true
FILE_REGISTRY_DB_URL=jdbc:postgresql://localhost:5432/tdfileregistry
FILE_REGISTRY_DB_USERNAME=postgres
FILE_REGISTRY_DB_PASSWORD=postgres
FILE_REGISTRY_GC_ENABLED=true
FILE_REGISTRY_GC_CRON=0 30 2 * * *
FILE_REGISTRY_GRACE_PERIOD=7d

# ---- Developer instance id - nhiều instance phải KHÁC nhau ----
WORKER_INSTANCE_ID=

# ---- Logging ----
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_TD_WORKER=INFO
LOG_FILE=logs/td-worker.log
# ---- Ky so SIM-PKI (MSSP/ETSI TS 102 204) - module MOI docs/17-checklist ----
# SimPkiProperties @ConfigurationProperties(prefix=worker.tasks.simpki).
# CANH BAO: bat enabled=true se set javax.net.ssl.keyStore/trustStore TOAN CUC cho tien trinh Worker
# (yeu cau bat buoc cua SDK Axis 1.4 - anh huong ca WorkerHttpClient) - xem docs/17-checklist muc 0.4,
# can nhac tach worker instance rieng neu instance nay con goi HTTPS ra dich vu khac.
# ap-id/ap-password/trust-store-*/key-store-* la BAT BUOC cau hinh THAT (Cuc CTS-BMTT cap) truoc khi bat.
WORKER_TASKS_SIMPKI_ENABLED=false
WORKER_TASKS_SIMPKI_SIGNATUREURL=https://mpki1.ca.gov.vn:18083/soap/services/MSS_SignaturePort
WORKER_TASKS_SIMPKI_MSSPID=http://hmssp.mobile-id.vn
WORKER_TASKS_SIMPKI_SIGNATUREPROFILE=http://mobile-id.vn/digitalSignature
WORKER_TASKS_SIMPKI_MSSFORMAT=http://uri.etsi.org/TS102204/v1.1.2#PKCS1
WORKER_TASKS_SIMPKI_APID=
WORKER_TASKS_SIMPKI_APPASSWORD=
WORKER_TASKS_SIMPKI_TIMEOUTSECONDS=300
WORKER_TASKS_SIMPKI_TRUSTSTOREPATH=
WORKER_TASKS_SIMPKI_TRUSTSTOREPASSWORD=
WORKER_TASKS_SIMPKI_KEYSTOREPATH=
WORKER_TASKS_SIMPKI_KEYSTOREPASSWORD=
WORKER_TASKS_SIMPKI_KEYSTORETYPE=PKCS12
WORKER_TASKS_SIMPKI_REPLYTASKTYPE=simpki.sign_reply

# ---- Đồng bộ Elasticsearch (16/10/2026) - docs/21-dong-bo-elasticsearch.md ----
# Nguồn: hàng đợi search_index_queue trong DB TỪNG tenant (trigger, td-web migration V1.0.72).
# Cluster ES DÙNG CHUNG với hệ khác (Domino data_data_*...) -> mọi index có tiền tố riêng
# (alias {prefix}-{tenant}-{entity}, vd hscv-h05-vbdi). Bỏ trống ELASTICSEARCH_URIS = không chạy
# (hàng đợi vẫn ghi, cấu hình sau rồi khởi động lại worker sẽ tự bù). Nhiều node: phân tách dấu phẩy.
WORKER_SEARCH_SYNC_ENABLED=true
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
WORKER_SEARCH_SYNC_INDEX_PREFIX=hscv
# Tăng khi đổi mapping/analyzer -> tạo index mới, chuyển alias, nạp lại toàn bộ.
WORKER_SEARCH_SYNC_MAPPING_VERSION=1
WORKER_SEARCH_SYNC_SHARDS=1
# 0 cho cluster 1 node (tránh index yellow); >=1 khi cluster nhiều node.
WORKER_SEARCH_SYNC_REPLICAS=0
# Đánh thức theo sự kiện (LISTEN/NOTIFY) - mỗi tenant giữ 1 kết nối PostgreSQL thường trực (tính vào max_connections).
WORKER_SEARCH_SYNC_NOTIFY_ENABLED=true
# Quét DỰ PHÒNG (bù thông báo lỡ, đối soát, số liệu) - không còn là đường chính.
WORKER_SEARCH_SYNC_FALLBACK_SWEEP_INTERVAL=2m
# Số tenant xử lý đồng thời.
WORKER_SEARCH_SYNC_MAX_PARALLEL_TENANTS=4
WORKER_SEARCH_SYNC_BATCH_SIZE=500
WORKER_SEARCH_SYNC_RECONCILE_INTERVAL=6h
# Rỗng = mọi tenant active; hoặc danh sách tenant_id phân tách dấu phẩy.
WORKER_SEARCH_SYNC_TENANTS=
WORKER_SEARCH_SYNC_EXCLUDED_COLUMNS=

# ---- Trích nội dung tệp đính kèm - docs/architecture/14-trich-noi-dung-tep.md (Tika, KHÔNG OCR; cần MINIO_ENABLED=true) ----
WORKER_FILE_EXTRACT_ENABLED=false
WORKER_FILE_EXTRACT_MAX_FILE_BYTES=52428800
WORKER_FILE_EXTRACT_FILE_TIMEOUT=5m
WORKER_FILE_EXTRACT_MAX_PARALLEL_TENANTS=2
